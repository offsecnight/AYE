# ── Server-side only (Next.js proxy reads this to reach the backend)
BACKEND_URL=http://localhost:4000

# ── Browser-side: Socket.io direct connection
# LOCAL DEV: leave unset — socket.ts will use same-origin proxy via server.js
# SLATE/CLOUD: set to the AppSail backend URL so the browser connects directly
# (Slate has no Node.js WS proxy — browser must connect to backend directly)
NEXT_PUBLIC_SOCKET_URL=https://aye-backend-50047496537.development.catalystappsail.in
